---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Book a Consultation"
  description="Book a consultation with Laser Clinics Cairns."
>
  <div class="mx-auto max-w-prose px-5 md:px-8 py-14 md:py-20 text-center">
    <h1 class="mb-6">Book a Consultation</h1>
    <p class="text-lg text-stone-600 leading-relaxed mb-10">
      Consultations are booked directly through Laser Clinics Cairns, where a
      clinician can assess your skin and discuss what's suitable for you.
    </p>
    <a
      href="https://www.laserclinics.com.au/skin-consultation/?action=book"
      class="btn-primary no-underline"
    >
      Continue to Laser Clinics Cairns
    </a>
  </div>
</BaseLayout>
