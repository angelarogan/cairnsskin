---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Get in touch with Cairns Skin.">
  <div class="mx-auto max-w-prose px-5 md:px-8 py-14 md:py-20">
    <h1 class="mb-6">Contact</h1>
    <p class="text-stone-600 leading-relaxed mb-8">
      For treatment bookings, please contact Laser Clinics Cairns directly.
      For questions about this website's content, use the details below.
    </p>

    <div class="card-flat p-6 space-y-3">
      <p class="text-sm text-stone-500">
        <!-- PLACEHOLDER — confirm current Laser Clinics Cairns contact details before publishing -->
        Phone: <span class="text-stone-400">[verify current clinic phone number]</span>
      </p>
      <p class="text-sm text-stone-500">
        Address: <span class="text-stone-400">[verify current clinic address]</span>
      </p>
      <p class="text-sm text-stone-500">
        Email: <span class="text-stone-400">[verify current enquiries email]</span>
      </p>
    </div>

    <p class="text-xs text-stone-400 mt-6">
      Contact details on this page are placeholders pending verification against
      Laser Clinics Cairns' current information.
    </p>
  </div>
</BaseLayout>
