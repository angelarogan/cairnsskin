---
import SectionHeading from "../ui/SectionHeading.astro";

const standards = [
  {
    title: "Written to answer real questions",
    body: "Every article opens with a direct answer to a specific question, then expands into detail.",
  },
  {
    title: "Reviewed before publication",
    body: "Health and treatment content moves through clinical and compliance review before it goes live.",
  },
  {
    title: "Evidence clearly labelled",
    body: "We distinguish established research, emerging evidence, manufacturer claims and clinical experience.",
  },
  {
    title: "Dated and attributed",
    body: "Every article shows its author, reviewer and last-reviewed date.",
  },
];
---

<section class="mx-auto max-w-editorial px-5 md:px-8 py-16 md:py-20">
  <SectionHeading
    eyebrow="How we work"
    title="Evidence and review standards"
    align="center"
  />

  <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {standards.map((s) => (
      <div class="text-center px-2">
        <div class="h-8 w-8 rounded-full bg-eucalyptus-100 mx-auto mb-4 flex items-center justify-center">
          <span class="h-2 w-2 rounded-full bg-eucalyptus-500" aria-hidden="true"></span>
        </div>
        <p class="text-sm font-medium text-ink mb-1.5">{s.title}</p>
        <p class="text-xs text-stone-500 leading-relaxed">{s.body}</p>
      </div>
    ))}
  </div>
</section>
