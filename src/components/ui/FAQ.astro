---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = "Related questions" } = Astro.props;
---

{items.length > 0 && (
  <section class="my-12" aria-label={title}>
    <h2 class="mb-6">{title}</h2>
    <div class="divide-y divide-stone-200 border-t border-b border-stone-200">
      {items.map((item) => (
        <details class="group py-5">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-ink font-medium">
            <span>{item.question}</span>
            <span class="text-eucalyptus-600 shrink-0 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-stone-600 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
