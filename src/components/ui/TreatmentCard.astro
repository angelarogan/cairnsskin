---
interface Props {
  href: string;
  title: string;
  summary: string;
  verified?: boolean;
}

const { href, title, summary, verified = false } = Astro.props;
---

<a href={href} class="card-flat block p-6 no-underline group hover:border-eucalyptus-300 transition-colors duration-200">
  <div class="flex items-start justify-between gap-3 mb-2">
    <h3 class="text-lg text-ink group-hover:text-eucalyptus-700 transition-colors">
      {title}
    </h3>
    {!verified && <span class="pill-status shrink-0">Pending verification</span>}
  </div>
  <p class="text-sm text-stone-600">{summary}</p>
  <span class="inline-block mt-4 font-mono text-xs text-eucalyptus-700 no-underline">Learn more &rarr;</span>
</a>
