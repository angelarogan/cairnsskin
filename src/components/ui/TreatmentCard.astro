---
interface Props {
  href: string;
  title: string;
  summary: string;
  verified?: boolean;
}

const { href, title, summary, verified = false } = Astro.props;
---

<a href={href} class="card-flat block p-6 no-underline group hover:border-eucalyptus-300 transition-colors duration-200">
  <div class="flex items-start justify-between gap-3 mb-2">
    <h3 class="text-lg font-medium text-ink group-hover:text-eucalyptus-700 transition-colors">
      {title}
    </h3>
    {!verified && (
      <span class="shrink-0 text-[11px] uppercase tracking-wide text-stone-400 border border-stone-300 rounded-full px-2 py-0.5">
        Pending verification
      </span>
    )}
  </div>
  <p class="text-sm text-stone-600">{summary}</p>
  <span class="inline-block mt-4 text-sm text-eucalyptus-600 no-underline">Learn more &rarr;</span>
</a>
