---
interface Props {
  href: string;
  question: string;
  shortAnswer: string;
  category?: string;
}

const { href, question, shortAnswer, category } = Astro.props;
---

<a href={href} class="glass-card block p-6 no-underline group">
  {category && <p class="eyebrow mb-2">{category}</p>}
  <h3 class="text-lg font-medium text-ink mb-2 group-hover:text-eucalyptus-700 transition-colors">
    {question}
  </h3>
  <p class="text-sm text-stone-600 line-clamp-2">{shortAnswer}</p>
</a>
