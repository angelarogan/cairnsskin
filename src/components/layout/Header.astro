---
const navLinks = [
  { label: "Skin Concerns", href: "/skin-concerns/" },
  { label: "Treatments", href: "/treatments/" },
  { label: "Knowledge Library", href: "/questions/" },
  { label: "About", href: "/about/" },
];
---

<header class="sticky top-0 z-50 glass-nav">
  <div class="mx-auto max-w-editorial px-5 md:px-8 h-16 flex items-center justify-between">
    <a href="/" class="text-lg font-medium tracking-tight text-ink no-underline">
      Cairns Skin
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-stone-700 no-underline hover:text-eucalyptus-700 transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a href="/book/" class="btn-primary text-sm py-2.5 px-5 no-underline">
        Book a Consultation
      </a>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full border border-stone-300"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Open menu</span>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M1 4h16M1 9h16M1 14h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden fixed inset-0 top-16 z-40 bg-paper-warm/95 backdrop-blur-md"
  >
    <nav aria-label="Mobile" class="flex flex-col gap-1 px-5 pt-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="py-3 text-lg text-ink no-underline border-b border-stone-200"
        >
          {link.label}
        </a>
      ))}
      <a href="/book/" class="btn-primary mt-6 no-underline">Book a Consultation</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("hidden", isOpen);
    document.body.classList.toggle("overflow-hidden", !isOpen);
  });
</script>
