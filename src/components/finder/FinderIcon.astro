---
// Minimal single-stroke line icons, matching Cairns Skin's restrained
// editorial style. No fills, no multi-colour illustration.
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "w-6 h-6" } = Astro.props;

const paths: Record<string, string> = {
  pigmentation:
    "M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M6 6l1.5 1.5M16.5 16.5L18 18M18 6l-1.5 1.5M7.5 16.5L6 18 M12 8a4 4 0 100 8 4 4 0 000-8z",
  redness: "M12 3c3 4 6 7.6 6 11a6 6 0 11-12 0c0-3.4 3-7 6-11z",
  acne: "M9 8a1.2 1.2 0 100 2.4A1.2 1.2 0 009 8zM16 7a1.2 1.2 0 100 2.4A1.2 1.2 0 0016 7zM13 13a1.2 1.2 0 100 2.4A1.2 1.2 0 0013 13zM7 15a1.2 1.2 0 100 2.4A1.2 1.2 0 007 15zM17 16a1.2 1.2 0 100 2.4A1.2 1.2 0 0017 16z",
  ageing: "M4 15c2-3 4-4.5 8-4.5s6 1.5 8 4.5M4 10c2-2.4 4-3.5 8-3.5s6 1.1 8 3.5",
  "skin-tone": "M12 21a9 9 0 100-18 9 9 0 000 18zM12 3a9 15 0 010 18",
  texture: "M4 6h4M12 6h4M4 12h4M12 12h4M4 18h4M12 18h4",
  body: "M12 3a2.4 2.4 0 110 4.8A2.4 2.4 0 0112 3zM8 21l1.4-8.5L7 10l1.5-3h7L17 10l-2.4 2.5L16 21M9.4 12.5h5.2",
  hair: "M6 20c0-6 1-9 2-11M10 20c0-7 .5-11 2-13M14 20c0-7-.5-11-2-13M18 20c0-6-1-9-2-11",
};

const d = paths[name] ?? paths.texture;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
