---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { buildSeo, SITE_NAME, SITE_URL } from "../utils/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalUrl,
  noindex = false,
  ogImage = "/images/og-default.png",
  structuredData,
} = Astro.props;

const seo = buildSeo({
  title,
  description,
  canonicalUrl,
  path: Astro.url.pathname,
  noindex,
});

const schemaList = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,340;9..144,480;9..144,560&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    {schemaList.map((data) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
    ))}

    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        (function () {
          // Self-service opt-out: visiting ?ga_exclude=1 once on a device
          // sets a permanent flag in that browser so all future visits
          // (any page) skip analytics entirely, including pageviews.
          // Visit ?ga_include=1 to turn tracking back on for that device.
          // IP-based exclusion (GA4's built-in method) isn't reliable
          // across phone/laptop on different networks, so this is used
          // instead.
          var params = new URLSearchParams(window.location.search);
          if (params.has("ga_exclude")) localStorage.setItem("ga_exclude", "1");
          if (params.has("ga_include")) localStorage.removeItem("ga_exclude");
          if (localStorage.getItem("ga_exclude") === "1") return;

          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", gaId);

          var script = document.createElement("script");
          script.async = true;
          script.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
          document.head.appendChild(script);

          document.addEventListener("click", (event) => {
            const link = event.target.closest("a");
            if (!link) return;
            if (link.getAttribute("href") === "/book/") {
              gtag("event", "book_consultation_click", {
                event_category: "engagement",
                page_path: window.location.pathname,
              });
            } else if (link.href.startsWith("https://www.laserclinics.com.au/skin-consultation")) {
              gtag("event", "book_consultation_outbound_click", {
                event_category: "conversion",
              });
            }
          });
        })();
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-paper-warm">
    <div class="grain" aria-hidden="true"></div>
    <div class="ambient" aria-hidden="true">
      <span class="amb-1"></span>
      <span class="amb-2"></span>
      <span class="amb-3"></span>
      <span class="amb-4"></span>
    </div>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
