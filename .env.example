# Cairns Skin does not require any environment variables to build or
# run locally beyond the optional analytics ID below.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Get this from
# the GA4 property's Admin > Data Streams > (your web stream) page.
# Leave unset locally/in preview builds — analytics only loads when
# this is set, which should only be in the production Netlify env.
PUBLIC_GA_MEASUREMENT_ID=

# Example (not yet used):
# ANTHROPIC_API_KEY=
